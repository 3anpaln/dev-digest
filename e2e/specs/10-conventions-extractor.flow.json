{
  "name": "Review a convention and create a workspace skill",
  "steps": [
    { "cmd": ["open", "{BASE}"], "label": "Open the seeded repository" },
    { "cmd": ["find", "role", "link", "click", "--name", "Conventions"], "label": "Open Conventions from Skills Lab" },
    { "cmd": ["wait", "--text", "Throw typed domain errors for billing operations"], "label": "Wait for the seeded scan" },
    { "cmd": ["wait", "aside a[href$='/conventions']"], "label": "Verify the Studio sidebar stays visible" },
    { "cmd": ["wait", "--text", "Search or jump to"], "label": "Verify the Studio top bar stays visible" },
    { "cmd": ["wait", "--text", "2 examples across 2 files"], "label": "Check the verified evidence count" },
    { "cmd": ["wait", "--fn", "(() => { const branch = document.querySelector('#conventions-branch'); return branch?.value === 'main' && branch.closest('details')?.open === false && document.querySelector('#conventions-focus')?.value === '20' && document.querySelector('#conventions-tokens')?.value === '5000'; })()"], "label": "Verify collapsed scan options and default settings" },
    { "cmd": ["wait", "#conventions-pending button[aria-expanded='true']"], "label": "Verify Pending starts expanded" },
    { "cmd": ["find", "role", "button", "click", "--name", "Edit"], "label": "Edit the finding scope" },
    { "cmd": ["find", "label", "Applies to", "fill", "src/billing/domain/**"], "label": "Narrow the rule to the billing domain" },
    { "cmd": ["find", "role", "button", "click", "--name", "Save finding"], "label": "Save the scope" },
    { "cmd": ["wait", "--text", "src/billing/domain/**"], "label": "See the saved scope" },
    { "cmd": ["select", "select[aria-label='Review decision']", "rejected"], "label": "Reject from the review decision control" },
    { "cmd": ["wait", "#conventions-rejected button[aria-expanded='false']"], "label": "Verify Rejected starts collapsed" },
    { "cmd": ["click", "#conventions-rejected button"], "label": "Open the Rejected group" },
    { "cmd": ["wait", "select[data-decision='rejected']"], "label": "See the saved rejection" },
    { "cmd": ["select", "select[aria-label='Review decision']", "pending"], "label": "Return the finding to pending" },
    { "cmd": ["wait", "select[data-decision='pending']"], "label": "See the saved pending state" },
    { "cmd": ["select", "select[aria-label='Review decision']", "accepted"], "label": "Accept the edited finding" },
    { "cmd": ["wait", "--text", "1 of 1 accepted"], "label": "Wait for the decision to persist" },
    { "cmd": ["reload"], "label": "Reload the accepted finding" },
    { "cmd": ["wait", "--text", "1 of 1 accepted"], "label": "Verify the saved decision after reload" },
    { "cmd": ["wait", "#conventions-accepted button[aria-expanded='false']"], "label": "Verify Accepted starts collapsed" },
    { "cmd": ["click", "#conventions-accepted button"], "label": "Open the Accepted group" },
    { "cmd": ["wait", "article button[aria-expanded='false']"], "label": "Verify reviewed findings start collapsed" },
    { "cmd": ["click", "article button[aria-expanded='false']"], "label": "Open the accepted finding" },
    { "cmd": ["wait", "--text", "Accepted on"], "label": "Verify the approval timestamp" },
    { "cmd": ["find", "role", "button", "click", "--name", "Create skill"], "label": "Open the generated skill draft" },
    { "cmd": ["wait", "dialog[open]"], "label": "Wait for the draft dialog" },
    { "cmd": ["wait", "--fn", "(() => { const rect = document.querySelector('dialog[open]')?.getBoundingClientRect(); return rect && Math.abs(rect.left + rect.width / 2 - innerWidth / 2) < 2 && Math.abs(rect.top + rect.height / 2 - innerHeight / 2) < 2; })()"], "label": "Verify the skill dialog is centered in the viewport" },
    { "cmd": ["wait", "--fn", "document.querySelector('dialog textarea')?.value.includes('src/billing/domain/**')"], "label": "Verify the edited scope is in Markdown" },
    { "cmd": ["press", "Escape"], "label": "Discard the initial draft with the keyboard" },
    { "cmd": ["wait", "--fn", "!document.querySelector('dialog[open]') && document.activeElement?.textContent?.trim() === 'Create skill'"], "label": "Verify focus returns to Create skill" },
    { "cmd": ["find", "role", "button", "click", "--name", "Create skill"], "label": "Open a fresh skill draft" },
    { "cmd": ["wait", "dialog[open]"], "label": "Wait for the new draft dialog" },
    { "cmd": ["fill", "dialog input[required]", "Flow billing conventions"], "label": "Rename the new skill" },
    { "cmd": ["click", "dialog button[type=submit]"], "label": "Create the edited skill" },
    { "cmd": ["wait", "--url", "**/skills?skill=**"], "label": "Open the saved skill in Skills Lab" },
    { "cmd": ["wait", "--text", "Flow billing conventions"], "label": "Verify the saved skill name" },
    { "cmd": ["find", "role", "link", "click", "--name", "Conventions"], "label": "Return to Conventions" },
    { "cmd": ["find", "role", "button", "click", "--name", "Clear all decisions"], "label": "Open the warning" },
    { "cmd": ["find", "role", "button", "click", "--name", "Cancel", "--exact"], "label": "Cancel clearing decisions" },
    { "cmd": ["wait", "--text", "1 of 1 accepted"], "label": "Verify cancellation preserves the decision" },
    { "cmd": ["find", "role", "button", "click", "--name", "Clear all decisions"], "label": "Open the warning again" },
    { "cmd": ["find", "role", "button", "click", "--name", "Clear decisions", "--exact"], "label": "Confirm clearing decisions" },
    { "cmd": ["wait", "--text", "All review decisions cleared."], "label": "Verify the bulk reset" },
    { "cmd": ["wait", "--text", "0 of 1 accepted"], "label": "Verify the finding is pending" }
  ]
}
